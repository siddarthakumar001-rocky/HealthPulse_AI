# ==========================================
# HealthPulse AI — Production Environment Config
# ==========================================

# Server Configuration
PORT=5001
NODE_ENV=production

# Frontend Client Origin (For CORS)
FRONTEND_URL=https://health-sepia-three.vercel.app
VITE_API_URL=http://localhost:5001

# MongoDB Connection String & Pool Settings
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/healthDB?retryWrites=true&w=majority
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5

# JSON Web Token Secret
JWT_SECRET=your_ultra_secure_random_jwt_secret_min_32_chars

# Redis Cache & Queue (Optional - falls back to high-performance in-memory cache)
REDIS_URL=redis://default:<password>@127.0.0.1:6379

# IoT ESP32 Telemetry API Key
DEVICE_API_KEY=your_esp32_iot_device_secret_key

# External AI Providers
GROQ_API_KEY=gsk_your_groq_api_key
GROK_API_KEY=xai_your_grok_api_key
DEEPSEEK_API_KEY=sk_your_deepseek_api_key

# Payment Gateway (Razorpay / Stripe)
PAYMENT_KEY_ID=rzp_live_your_payment_key_id
PAYMENT_KEY_SECRET=your_payment_key_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_cryptographic_secret
